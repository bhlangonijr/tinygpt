# The convergence arm: where, as K -> N, does m+v AdamW recover dense quality, and at what memory?
# Run with:  python train_spectral.py --sweep experiments/highk_curve.jsonl --out runs/highk_curve
#
# Every spectral run is m+v with --fixed-k, so K is exactly the stated fraction (no
# controller). All runs share one dense control from the same sweep: same data order,
# init, eval windows and GPU (recorded in summary.json).
#
# Two floor arms, because the floor is itself a change to AdamW even with no truncation
# (K = N; measured in spec section 45). The 1e-8 arm continues the screen's setting; the 0 arm
# isolates compression from the floor. At low K a zero floor collapses the denominator
# (spec section 15), so the 0 arm starts at 50%.
#
# Memory break-even against dense state: DCT-TopK (4B value + 4B index) at K/N = 50%,
# DCT-Low (4B value + a shared int32 prefix) below K/N = 100%.
{"name": "hk_adamw_dense", "opt": "adamw", "state": "dense", "scale": "micro", "steps": 3000, "no_ckpt": true}
{"name": "hk_low_k005_f8", "opt": "adamw", "state": "dct", "select": "low", "kmax_frac": 0.05, "fixed_k": true, "v_floor": 1e-08, "scale": "micro", "steps": 3000, "no_ckpt": true}
